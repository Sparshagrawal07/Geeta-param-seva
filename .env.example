# Set to true to use the local Firebase Functions emulator (account deletion, etc.)
EXPO_PUBLIC_USE_FUNCTIONS_EMULATOR=false

# AdMob app IDs (native). Defaults to Google sample IDs until you set production values.
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxx~yyyyyyyy
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxx~zzzzzzzz

# Senior admin seed PINs (used with scripts/data/senior-admins.local.json)
# SENIOR_ADMIN_PIN=
# HRIDYA_SENIOR_ADMIN_PIN=

# Optional: enable App Check enforcement on Cloud Functions after client setup
# ENFORCE_APP_CHECK=true
