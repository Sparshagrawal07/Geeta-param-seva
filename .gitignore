# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Generated by Expo / native config plugins (may embed AdMob app IDs from .env).
# Source of truth is app.config.js — keep app.json local/untracked.
app.json

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files & secrets
.env
.env*.local
functions/.env
.secrets/

# Firebase / Google native config (API keys + project ids) — keep local copies; see *.example
google-services.json
GoogleService-Info.plist

# Real roster / member PII used only for local seeding
scripts/data/group-1-roster.json
scripts/data/*.local.json
scripts/data/senior-admins.local.json

# firebase
functions/lib/

# typescript
*.tsbuildinfo

# Local size-report / export artifacts
.size-report/
