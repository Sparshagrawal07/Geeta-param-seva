[debug] [2026-09-14T23:35:30.007Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/geeta-param-seva-6aa03/rulesets {"name":"projects/geeta-param-seva-6aa03/rulesets/60c97686-f626-4dce-ac41-86866aba5eb9","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function userDoc(uid) {\n      return get(/databases/$(database)/documents/users/$(uid)).data;\n    }\n\n    function userData() {\n      return userDoc(request.auth.uid);\n    }\n\n    function isSeniorAdmin() {\n      return isSignedIn() && userData().role == 'senior_admin';\n    }\n\n    function isGroupAdmin(groupId) {\n      return isSignedIn()\n        && userData().role == 'admin'\n        && groupId in userData().assignedGroupIds;\n    }\n\n    function canManageGroup(groupId) {\n      return isSeniorAdmin() || isGroupAdmin(groupId);\n    }\n\n    function canReadGroupContent(groupId) {\n      return isSeniorAdmin()\n        || isGroupAdmin(groupId)\n        || (isSignedIn() && userData().role == 'user' && userData().groupId == groupId);\n    }\n\n    function pollGroupId(pollId) {\n      return get(/databases/$(database)/documents/polls/$(pollId)).data.groupId;\n    }\n\n    function canVoteOnPoll(pollId) {\n      let groupId = pollGroupId(pollId);\n      return isSignedIn()\n        && userData().role == 'user'\n        && userData().groupId == groupId;\n    }\n\n    function canReadGroup(groupId) {\n      return canReadGroupContent(groupId);\n    }\n\n    function sharesGroupWith(target) {\n      return userData().groupId != null\n        && target.groupId == userData().groupId;\n    }\n\n    function adminManagesTarget(target) {\n      return userData().role == 'admin'\n        && (\n          (target.groupId != null && target.groupId in userData().assignedGroupIds)\n          || (target.role == 'admin' && target.assignedGroupIds.hasAny(userData().assignedGroupIds))\n          || target.role == 'senior_admin'\n        );\n    }\n\n    function canReadUserProfile(userId) {\n      let target = userDoc(userId);\n      return isSignedIn() && (\n        request.auth.uid == userId\n        || isSeniorAdmin()\n        || adminManagesTarget(target)\n        || (userData().role == 'user' && (\n          sharesGroupWith(target)\n          || (target.role == 'admin' && userData().groupId in target.assignedGroupIds)\n          || target.role == 'senior_admin'\n        ))\n      );\n    }\n\n    function ownerProfileUpdateAllowed(userId) {\n      return isSignedIn()\n        && request.auth.uid == userId\n        && request.resource.data.phoneNumber == resource.data.phoneNumber\n        && !('role' in request.resource.data.diff(resource.data).affectedKeys())\n        && !('groupId' in request.resource.data.diff(resource.data).affectedKeys())\n        && !('assignedGroupIds' in request.resource.data.diff(resource.data).affectedKeys())\n        && !('whitelistKey' in request.resource.data.diff(resource.data).affectedKeys())\n        && !('seniorAdminKey' in request.resource.data.diff(resource.data).affectedKeys())\n        && !('hasPersonalPin' in request.resource.data.diff(resource.data).affectedKeys())\n        && !('activeSessionId' in request.resource.data.diff(resource.data).affectedKeys())\n        && !('activeSessionUpdatedAt' in request.resource.data.diff(resource.data).affectedKeys());\n    }\n\n    function canReadRosterEntry() {\n      return isSeniorAdmin()\n        || (\n          isSignedIn()\n          && userData().role == 'admin'\n          && (\n            (resource.data.role == 'user'\n              && resource.data.groupId != null\n              && resource.data.groupId in userData().assignedGroupIds)\n            || (resource.data.role == 'admin'\n              && resource.data.assignedGroupIds.hasAny(userData().assignedGroupIds))\n          )\n        );\n    }\n\n    // Admins may run collection queries; client scopes by groupId.\n    // (Firestore rejects list queries that depend on `in assignedGroupIds` alone.)\n    function canListRosterAsAdmin() {\n      return isSeniorAdmin()\n        || (isSignedIn() && userData().role == 'admin');\n    }\n\n    function canListUsersAsAdmin() {\n      return isSeniorAdmin()\n        || (isSignedIn() && userData().role == 'admin');\n    }\n\n    match /groups/{groupId} {\n      allow read: if canReadGroup(groupId);\n      allow create, delete: if isSeniorAdmin();\n      allow update: if isSeniorAdmin()\n        || (\n          canManageGroup(groupId)\n          && request.resource.data.diff(resource.data).affectedKeys()\n            .hasOnly(['memberCount', 'postCount', 'pollCount', 'todaysPollResponseCount', 'statsUpdatedAt'])\n        )\n        || (\n          // Voters may bump today's poll response counter for their own group only.\n          isSignedIn()\n          && userData().role == 'user'\n          && userData().groupId == groupId\n          && request.resource.data.diff(resource.data).affectedKeys()\n            .hasOnly(['todaysPollResponseCount', 'statsUpdatedAt'])\n        );\n\n      match /push_tokens/{tokenId} {\n        allow read: if false;\n        allow create, update: if isSignedIn()\n          && request.resource.data.uid == request.auth.uid;\n        allow delete: if isSignedIn()\n          && resource.data.uid == request.auth.uid;\n      }\n    }\n\n    match /users/{userId} {\n      allow get: if canReadUserProfile(userId);\n      allow list: if canListUsersAsAdmin();\n      // Profiles are created by Cloud Functions during PIN sign-in\n      allow create: if false;\n      allow update: if ownerProfileUpdateAllowed(userId) || isSeniorAdmin();\n      allow delete: if (isSignedIn() && request.auth.uid == userId) || isSeniorAdmin();\n\n      match /devices/{deviceId} {\n        allow read, write: if isSignedIn() && request.auth.uid == userId;\n      }\n\n      // Sessions are written by Cloud Functions; client may only read own session.\n      match /sessions/{deviceId} {\n        allow read: if isSignedIn() && request.auth.uid == userId;\n        allow write: if false;\n      }\n    }\n\n    // Global PIN uniqueness index — Admin SDK / Cloud Functions only\n    match /pin_hashes/{pinHash} {\n      allow read, write: if false;\n    }\n\n    match /posts/{postId} {\n      allow read: if canReadGroupContent(resource.data.groupId);\n      allow create: if canManageGroup(request.resource.data.groupId);\n      // Deletes have no request.resource — only check existing doc + manager role.\n      allow update: if canManageGroup(resource.data.groupId)\n        && request.resource.data.groupId == resource.data.groupId;\n      allow delete: if canManageGroup(resource.data.groupId);\n    }\n\n    match /polls/{pollId} {\n      allow read: if canReadGroupContent(resource.data.groupId);\n      allow create: if canManageGroup(request.resource.data.groupId);\n      allow update: if (\n          canManageGroup(resource.data.groupId)\n          && request.resource.data.groupId == resource.data.groupId\n        )\n        || (\n          isSignedIn()\n          && canReadGroupContent(resource.data.groupId)\n          && request.resource.data.groupId == resource.data.groupId\n          && request.resource.data.diff(resource.data).affectedKeys()\n            .hasOnly(['voteCount', 'optionCounts'])\n        );\n      // Deletes have no request.resource — only check existing doc + manager role.\n      allow delete: if canManageGroup(resource.data.groupId);\n    }\n\n    match /votes/{voteId} {\n      allow read: if isSignedIn() && canReadGroupContent(pollGroupId(resource.data.pollId));\n      allow create: if isSignedIn()\n        && request.resource.data.userId == request.auth.uid\n        && canVoteOnPoll(request.resource.data.pollId)\n        && (\n          !('groupId' in request.resource.data)\n          || request.resource.data.groupId == pollGroupId(request.resource.data.pollId)\n        );\n      allow update: if isSignedIn()\n        && request.resource.data.userId == request.auth.uid\n        && resource.data.userId == request.auth.uid\n        && request.resource.data.pollId == resource.data.pollId\n        && canVoteOnPoll(request.resource.data.pollId)\n        && (\n          !('groupId' in request.resource.data)\n          || request.resource.data.groupId == pollGroupId(request.resource.data.pollId)\n        );\n      // Prefer groupId on the vote (avoids get(poll) when deleting poll in same batch).\n      // Fall back to poll lookup for legacy votes without groupId.\n      allow delete: if isSignedIn()\n        && (\n          ('groupId' in resource.data && canManageGroup(resource.data.groupId))\n          || canManageGroup(pollGroupId(resource.data.pollId))\n        );\n    }\n\n    match /notifications/{notificationId} {\n      // Personal rows are readable by owner without group membership checks\n      // (required for uid + createdAt list queries to pass rules).\n      allow read: if isSignedIn()\n        && (\n          resource.data.uid == request.auth.uid\n          || (\n            canReadGroupContent(resource.data.groupId)\n            && (\n              !('uid' in resource.data)\n              || resource.data.uid == request.auth.uid\n              || canManageGroup(resource.data.groupId)\n            )\n          )\n        );\n      allow create, update, delete: if false;\n    }\n\n    match /admin_whitelist/{phoneId} {\n      allow get: if isSignedIn();\n      allow list, create, delete: if isSeniorAdmin();\n    }\n\n    // Roster writes are Cloud Functions / Admin SDK only.\n    match /access_roster/{phoneId} {\n      allow get: if canReadRosterEntry();\n      allow list: if canListRosterAsAdmin();\n      allow create, update, delete: if false;\n    }\n\n    // Join applications — Cloud Functions only (public submit + admin review via callables).\n    match /join_applications/{phoneId} {\n      allow read, write: if false;\n    }\n\n    match /senior_admins/{phoneId} {\n      allow read, write: if false;\n    }\n\n    // PIN hashes — Admin SDK / Cloud Functions only\n    match /group_pins/{groupId} {\n      allow read, write: if false;\n    }\n\n    match /notification_deliveries/{deliveryId} {\n      allow read: if canManageGroup(resource.data.groupId);\n      allow create, update, delete: if false;\n    }\n\n    match /gita_chapters/{chapterId} {\n      allow read: if isSignedIn();\n      allow write: if false;\n    }\n\n    match /gita_verses/{verseId} {\n      allow read: if isSignedIn();\n      allow write: if false;\n    }\n\n    match /member_practice_assignments/{uid} {\n      allow read: if isSignedIn()\n        && (\n          request.auth.uid == uid\n          || canManageGroup(resource.data.groupId)\n        );\n      allow create, update, delete: if false;\n    }\n\n    match /practice_completion_logs/{logId} {\n      allow read: if isSignedIn()\n        && (\n          resource.data.uid == request.auth.uid\n          || canManageGroup(resource.data.groupId)\n        );\n      allow create, update, delete: if false;\n    }\n\n    match /practice_content/{docId} {\n      allow read: if isSignedIn();\n      allow write: if false;\n    }\n\n    match /app_config/{docId} {\n      allow read: if isSignedIn();\n      allow write: if isSeniorAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-14T23:35:29.897167Z","metadata":{"services":["cloud.firestore"]}}
