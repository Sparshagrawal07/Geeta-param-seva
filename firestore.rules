rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userData() {
      return userDoc(request.auth.uid);
    }

    function isSeniorAdmin() {
      return isSignedIn() && userData().role == 'senior_admin';
    }

    function isGroupAdmin(groupId) {
      return isSignedIn()
        && userData().role == 'admin'
        && groupId in userData().assignedGroupIds;
    }

    function canManageGroup(groupId) {
      return isSeniorAdmin() || isGroupAdmin(groupId);
    }

    /**
     * Is the signed-in member part of this group?
     *
     * Accepts BOTH storage shapes on purpose: `groupIds` (multi-group, the source
     * of truth) and the older scalar `groupId` (the primary group). A profile
     * written before the backfill has only the scalar one, and a rule that ignored
     * it would lock those members out of their own group content mid-rollout.
     * Admins are deliberately excluded — they manage groups, they don't belong to
     * them, and `assignedGroupIds` is what grants them access.
     */
    function isMemberOfGroup(groupId) {
      return isSignedIn()
        && userData().role == 'user'
        && (
          (userData().groupId is string && userData().groupId == groupId)
          || (userData().groupIds is list && groupId in userData().groupIds)
        );
    }

    /** Two members may see each other's profile when they share any group. */
    function sharesGroupWith(target) {
      return userData().groupId != null
        && (
          target.groupId == userData().groupId
          || (target.groupIds is list && userData().groupId in target.groupIds)
        );
    }

    function canReadGroupContent(groupId) {
      return isSeniorAdmin()
        || isGroupAdmin(groupId)
        || isMemberOfGroup(groupId);
    }

    function pollGroupId(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId)).data.groupId;
    }

    function canVoteOnPoll(pollId) {
      let groupId = pollGroupId(pollId);
      return isSignedIn()
        && userData().role == 'user'
        && isMemberOfGroup(groupId);
    }

    function canReadGroup(groupId) {
      return canReadGroupContent(groupId);
    }

    function adminManagesTarget(target) {
      return userData().role == 'admin'
        && (
          (target.groupId != null && target.groupId in userData().assignedGroupIds)
          || (target.groupIds is list && target.groupIds.hasAny(userData().assignedGroupIds))
          || (target.role == 'admin' && target.assignedGroupIds.hasAny(userData().assignedGroupIds))
          || target.role == 'senior_admin'
        );
    }

    function canReadUserProfile(userId) {
      let target = userDoc(userId);
      return isSignedIn() && (
        request.auth.uid == userId
        || isSeniorAdmin()
        || adminManagesTarget(target)
        || (userData().role == 'user' && (
          sharesGroupWith(target)
          || (target.role == 'admin' && userData().groupId in target.assignedGroupIds)
          || target.role == 'senior_admin'
        ))
      );
    }

    function ownerProfileUpdateAllowed(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.phoneNumber == resource.data.phoneNumber
        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        // `groupIds` and `memberKey` are privilege-bearing: a member who could set
        // their own `groupIds` would grant themselves any group in the app, and one
        // who could set `memberKey` could read another member's practice assignment.
        && !('groupId' in request.resource.data.diff(resource.data).affectedKeys())
        && !('groupIds' in request.resource.data.diff(resource.data).affectedKeys())
        && !('memberKey' in request.resource.data.diff(resource.data).affectedKeys())
        && !('assignedGroupIds' in request.resource.data.diff(resource.data).affectedKeys())
        && !('whitelistKey' in request.resource.data.diff(resource.data).affectedKeys())
        && !('seniorAdminKey' in request.resource.data.diff(resource.data).affectedKeys())
        && !('hasPersonalPin' in request.resource.data.diff(resource.data).affectedKeys())
        && !('rosterStatus' in request.resource.data.diff(resource.data).affectedKeys())
        && !('activeSessionId' in request.resource.data.diff(resource.data).affectedKeys())
        && !('activeSessionUpdatedAt' in request.resource.data.diff(resource.data).affectedKeys());
    }

    function canReadRosterEntry() {
      return isSeniorAdmin()
        || (
          isSignedIn()
          && userData().role == 'admin'
          && (
            (resource.data.role == 'user'
              && (
                (resource.data.groupId != null
                  && resource.data.groupId in userData().assignedGroupIds)
                || (resource.data.groupIds is list
                  && resource.data.groupIds.hasAny(userData().assignedGroupIds))
              )
            || (resource.data.role == 'admin'
              && resource.data.assignedGroupIds.hasAny(userData().assignedGroupIds))
          )
        );
    }

    // Admins may run collection queries; client scopes by groupId.
    // (Firestore rejects list queries that depend on `in assignedGroupIds` alone.)
    function canListRosterAsAdmin() {
      return isSeniorAdmin()
        || (isSignedIn() && userData().role == 'admin');
    }

    function canListUsersAsAdmin() {
      return isSeniorAdmin()
        || (isSignedIn() && userData().role == 'admin');
    }

    match /groups/{groupId} {
      allow read: if canReadGroup(groupId);
      // nameNormalized backs the indexed availability lookup. Counter-only
      // updates remain compatible with legacy groups until the one-time backfill.
      allow create: if isSeniorAdmin()
        && request.resource.data.nameNormalized is string;
      allow delete: if isSeniorAdmin();
      allow update: if (
          isSeniorAdmin()
          && (
            request.resource.data.name == resource.data.name
            || request.resource.data.nameNormalized is string
          )
        )
        || (
          canManageGroup(groupId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberCount', 'postCount', 'pollCount', 'todaysPollResponseCount', 'statsUpdatedAt'])
        )
        || (
          // Voters may bump today's poll response counter for their own group only.
          isSignedIn()
          && isMemberOfGroup(groupId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['todaysPollResponseCount', 'statsUpdatedAt'])
        );

      match /push_tokens/{tokenId} {
        allow read: if false;
        allow create, update: if isSignedIn()
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    match /users/{userId} {
      allow get: if canReadUserProfile(userId);
      allow list: if canListUsersAsAdmin();
      // Profiles are created by Cloud Functions during PIN sign-in
      allow create: if false;
      allow update: if ownerProfileUpdateAllowed(userId) || isSeniorAdmin();
      allow delete: if (isSignedIn() && request.auth.uid == userId) || isSeniorAdmin();

      match /devices/{deviceId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Sessions are written by Cloud Functions; client may only read own session.
      match /sessions/{deviceId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Global PIN uniqueness index — Admin SDK / Cloud Functions only
    match /pin_hashes/{pinHash} {
      allow read, write: if false;
    }

    match /posts/{postId} {
      allow read: if canReadGroupContent(resource.data.groupId);
      allow create: if canManageGroup(request.resource.data.groupId);
      // Deletes have no request.resource — only check existing doc + manager role.
      allow update: if canManageGroup(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId;
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /content_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.contentType == 'post'
        && request.resource.data.status == 'open'
        && request.resource.data.reason in ['inappropriate', 'offensive', 'harassment', 'spam', 'incorrect', 'other']
        && request.resource.data.keys().hasAll([
          'reporterUid',
          'reporterName',
          'contentId',
          'contentType',
          'groupId',
          'contentCreatorUid',
          'contentCreatorName',
          'contentTitle',
          'reason',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.reporterName is string
        && request.resource.data.contentId is string
        && request.resource.data.groupId is string
        && request.resource.data.contentCreatorUid is string
        && request.resource.data.contentCreatorName is string
        && request.resource.data.contentTitle is string
        && (!('details' in request.resource.data)
          || (request.resource.data.details is string
            && request.resource.data.details.size() <= 300))
        && request.resource.data.contentCreatorUid != request.auth.uid
        && canReadGroupContent(request.resource.data.groupId)
        && reportId == request.resource.data.contentId + '_' + request.auth.uid;

      // get on a missing doc has resource == null; rules that read resource.data deny
      // and break the client's existence check before create.
      allow get: if isSignedIn()
        && (
          resource == null
          || resource.data.reporterUid == request.auth.uid
          || canManageGroup(resource.data.groupId)
        );

      allow list: if isSignedIn()
        && (
          resource.data.reporterUid == request.auth.uid
          || canManageGroup(resource.data.groupId)
        );

      allow update: if canManageGroup(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.contentId == resource.data.contentId
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.status in ['resolved', 'dismissed'];

      allow delete: if false;
    }

    match /polls/{pollId} {
      allow read: if canReadGroupContent(resource.data.groupId);
      allow create: if canManageGroup(request.resource.data.groupId);
      allow update: if (
          canManageGroup(resource.data.groupId)
          && request.resource.data.groupId == resource.data.groupId
        )
        || (
          isSignedIn()
          && canReadGroupContent(resource.data.groupId)
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['voteCount', 'optionCounts'])
        );
      // Deletes have no request.resource — only check existing doc + manager role.
      allow delete: if canManageGroup(resource.data.groupId);
    }

    match /votes/{voteId} {
      allow read: if isSignedIn() && canReadGroupContent(pollGroupId(resource.data.pollId));
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && canVoteOnPoll(request.resource.data.pollId)
        && (
          !('groupId' in request.resource.data)
          || request.resource.data.groupId == pollGroupId(request.resource.data.pollId)
        );
      allow update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.pollId == resource.data.pollId
        && canVoteOnPoll(request.resource.data.pollId)
        && (
          !('groupId' in request.resource.data)
          || request.resource.data.groupId == pollGroupId(request.resource.data.pollId)
        );
      // Prefer groupId on the vote (avoids get(poll) when deleting poll in same batch).
      // Fall back to poll lookup for legacy votes without groupId.
      allow delete: if isSignedIn()
        && (
          ('groupId' in resource.data && canManageGroup(resource.data.groupId))
          || canManageGroup(pollGroupId(resource.data.pollId))
        );
    }

    match /notifications/{notificationId} {
      // Personal rows are readable by owner without group membership checks
      // (required for uid + createdAt list queries to pass rules).
      allow read: if isSignedIn()
        && (
          resource.data.uid == request.auth.uid
          || (
            canReadGroupContent(resource.data.groupId)
            && (
              !('uid' in resource.data)
              || resource.data.uid == request.auth.uid
              || canManageGroup(resource.data.groupId)
            )
          )
        );
      allow create, update, delete: if false;
    }

    match /admin_whitelist/{phoneId} {
      allow get: if isSignedIn();
      allow list, create, delete: if isSeniorAdmin();
    }

    // Roster writes are Cloud Functions / Admin SDK only.
    match /access_roster/{phoneId} {
      allow get: if canReadRosterEntry();
      allow list: if canListRosterAsAdmin();
      allow create, update, delete: if false;
    }

    // Join applications — Cloud Functions only (public submit + admin review via callables).
    match /join_applications/{phoneId} {
      allow read, write: if false;
    }

    match /senior_admins/{phoneId} {
      allow read, write: if false;
    }

    // PIN hashes — Admin SDK / Cloud Functions only
    match /group_pins/{groupId} {
      allow read, write: if false;
    }

    match /notification_deliveries/{deliveryId} {
      allow read: if canManageGroup(resource.data.groupId);
      allow create, update, delete: if false;
    }

    match /gita_chapters/{chapterId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /gita_verses/{verseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /**
     * Standing practice assignments, one doc per (member alias, group).
     *
     * The doc id is `{alias}_{groupId}`, so it can no longer be compared to the
     * caller's uid — that check silently stopped matching the moment a second
     * group existed, which would have left the member's own practice unreadable.
     * Ownership is now decided by the doc's own `uid` / `memberKey` fields, with
     * `memberKey` mirroring the phone-keyed id onto the profile at sign-in.
     */
    match /member_practice_assignments/{assignmentId} {
      allow read: if isSignedIn()
        && (
          resource.data.uid == request.auth.uid
          || (resource.data.memberKey is string
            && userData().memberKey is string
            && resource.data.memberKey == userData().memberKey)
          || canManageGroup(resource.data.groupId)
        );
      allow create, update, delete: if false;
    }

    match /practice_completion_logs/{logId} {
      allow read: if isSignedIn()
        && (
          resource.data.uid == request.auth.uid
          || canManageGroup(resource.data.groupId)
        );
      allow create, update, delete: if false;
    }

    match /practice_content/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSeniorAdmin();
    }
  }
}
