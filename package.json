    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.14.0",
    "nativewind": "^4.2.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-google-mobile-ads": "^16.5.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "ffmpeg-static": "^5.3.0",
    "firebase-tools": "^15.19.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^3.2.6"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "functions:build": "npm --prefix functions run build",
    "functions:deploy": "npm run functions:build && firebase deploy --only functions --project geeta-param-seva-6aa03",
    "firestore:deploy": "firebase deploy --only firestore --project geeta-param-seva-6aa03",
    "deploy:backend": "npm run functions:build && firebase deploy --only functions,firestore --project geeta-param-seva-6aa03",
    "typecheck": "tsc --noEmit",
    "seed:gita": "node scripts/seed-gita-scripture.cjs",
    "seed:gita:apply": "node scripts/seed-gita-scripture.cjs --apply",
    "seed:practice": "node scripts/seed-member-practice.cjs",
    "seed:practice:apply": "node scripts/seed-member-practice.cjs --apply",
    "seed:ads-config": "node scripts/seed-ads-remote-config.cjs",
    "seed:ads-config:apply": "node scripts/seed-ads-remote-config.cjs --apply",
    "prepare:icons": "node scripts/prepare-brand-icons.mjs",
    "prepare:spiritual": "node scripts/prepare-spiritual-placeholders.mjs",
    "optimize:logo": "node scripts/prepare-brand-icons.mjs",
    "build:android:apk": "npx eas-cli build --platform android --profile preview",
    "build:android:apk:arm64": "npx eas-cli build --platform android --profile preview-arm64",
    "build:android:apk:save": "node scripts/build-and-save-android-apk.mjs --profile preview",
    "build:android:apk:arm64:save": "node scripts/build-and-save-android-apk.mjs --profile preview-arm64",
    "build:android:apk:local": "npx eas-cli build --platform android --profile preview --local --output dist/Geeta-Param-Seva.apk",
    "download:android:apk": "node scripts/download-android-apk.mjs --profile preview",
    "download:android:apk:arm64": "node scripts/download-android-apk.mjs --profile preview-arm64",
    "build:android:aab": "npx eas-cli build --platform android --profile production",
    "build:android:aab:local": "npx eas-cli build --platform android --profile production --local --output dist/Geeta-Param-Seva.aab",
    "install:android:apk": "npx eas-cli build:run -p android --latest --profile preview",
    "size:js": "npx expo export --platform android --output-dir .size-report/bundle && du -h .size-report/bundle/_expo/static/js/android/*.hbc"
  },
  "private": true,
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || >=24.3.0"
  }
}
